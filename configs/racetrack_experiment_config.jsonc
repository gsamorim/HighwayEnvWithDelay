{
  // =========================================================================
  // Unified experiment config -- HighwayEnv Racetrack + SAC.
  //
  // Keys here mirror scripts/train.py's CLI flags 1:1 (dashes -> underscores,
  // e.g. --oval-straight-length-m -> "oval_straight_length_m"). Any key can
  // be left out or set to null (falls back to train.py's own default), and
  // any flag passed explicitly on the command line always overrides this
  // file:
  //   python scripts/train.py --config configs/racetrack_experiment_config.jsonc
  //   python scripts/train.py --config configs/racetrack_experiment_config.jsonc --seed 1
  //
  // Comments mark which knobs are NOT valid for a given env_id -- those are
  // also enforced at runtime (RacetrackEnvConfig raises ValueError), not
  // just documented here.
  // =========================================================================

  // --- Run bookkeeping ----------------------------------------------------
  "seed": 0,
  "total_steps": 50000,
  "eval_episodes": 5,          // periodic eval during training (rl-baselines3-zoo default: 5-10)
  "run_name": null,            // null = auto-generated from env/agent/traffic/seed

  // --- 6) Environment switch ----------------------------------------------
  "env": "racetrack_oval",     // "racetrack" | "racetrack_oval" (registry.py)
  "env_id": "racetrack-oval-v0",
  // other env_id values seen in highway-env: racetrack-v0, racetrack-v1,
  // racetrack-large-v0, racetrack-large-v1, racetrack-oval-v1

  // --- 2) Oval track variant (racetrack-oval-* only) ----------------------
  // Chosen straight-length variants for this project: 80, 30, 5 m (+ the
  // ~100m native default as an implicit 4th/baseline variant, obtained by
  // leaving oval_straight_length_m null on a non-oval or default-length run).
  "oval_straight_length_m": 30,
  // "oval_no_lanes": null,    // native `no_lanes`; NOT yet an experiment
                                // axis for this project (pendencia em aberto
                                // -- see project doc); default 3 if unset.
  "oval_obstacle_preset": null, // null | "block_lane" | "force_decision"
  // Safety margin (meters) SafeSpawnWrapper enforces between the spawn and
  // any oval obstacle above -- only matters when oval_obstacle_preset is
  // set. null = wrapper's own default (15.0). Confirmed empirically that
  // WITHOUT this, "block_lane" + length=80 could spawn the car ~5m from an
  // obstacle (unavoidable collision unrelated to policy quality) -- see
  // SafeSpawnWrapper's docstring and project doc section 12.
  "obstacle_min_clearance_m": null,

  // --- 3) Acceleration control ---------------------------------------------
  // On by default (RacetrackEnvConfig.action_longitudinal=True). Set to
  // false to disable it (agent then only controls steering; acceleration
  // is held at 0 every step -- NOT auto-piloted to a target speed). Changes
  // the action vector from 2 dims to 1, which also changes obs_dim if
  // enable_delay_wrapper is on -- must match between a training run and
  // anything loading its checkpoint.
  "action_longitudinal": null,

  // --- 5) Obstacles --------------------------------------------------------
  // Only the two native oval presets above are supported today. Arbitrary
  // obstacle placement on racetrack-v0/v1/large-v0/v1 is still an open
  // pendencia (no native key, no wrapper-based solution yet). See also
  // obstacle_min_clearance_m above -- the presets' own placement is a
  // hardcoded offset from the end of the straight, same root bug class as
  // the spawn fix (section 9 of the project doc): it doesn't scale
  // meaningfully to a short straight (e.g. length=5 makes both presets a
  // no-op), it just no longer forces an unfair collision.

  // --- 4) Traffic speed (ours; not a native highway-env key) ---------------
  "traffic_speed_min": null,   // null (both null) disables the wrapper -> native spawn speed
  "traffic_speed_max": null,   // must be set together with traffic_speed_min

  // --- 6) Traffic intensity (native `other_vehicles`, via named presets) ---
  "traffic": "medium",         // "none" | "light" | "medium" | "heavy" | "jam", or an int

  // --- Agent selection + PPO (via stable-baselines3) -----------------------
  // null = train.py default ("sac", our from-scratch implementation). Set to
  // "ppo" to train with stable-baselines3's own PPO instead -- real training
  // then goes through SB3's `.learn()` loop (scripts/train.py::
  // train_sb3_ppo), not our off-policy Trainer; see
  // rl_platform/agents/ppo_sb3.py for why. Checkpoints are SB3's own `.zip`
  // format in that case, not our `.pt` state_dict -- scripts/record.py loads
  // either, matched by file extension.
  "agent": null,
  "ppo_n_steps": null,              // null = 2048 (SB3 default): rollout length per update
  "ppo_n_epochs": null,             // null = 10 (SB3 default): minibatch epochs per rollout
  "ppo_learning_rate": null,        // null = 3e-4
  "ppo_gamma": null,                // null = 0.99
  "ppo_gae_lambda": null,           // null = 0.95
  "ppo_clip_range": null,           // null = 0.2
  "ppo_ent_coef": null,             // null = 0.0
  "ppo_vf_coef": null,              // null = 0.5

  // "agent": "sac_sb3" -- SAC via stable-baselines3 (second implementation
  // of the same algorithm as "sac", for comparison against our
  // from-scratch one). buffer_size/batch_size/learning_starts above are
  // shared with "sac" (same meaning for both); these are SB3-SAC-only:
  "sac_sb3_learning_rate": null,          // null = 3e-4
  "sac_sb3_gamma": null,                  // null = 0.99
  "sac_sb3_tau": null,                    // null = 0.005 (SB3 default)
  "sac_sb3_train_freq": null,             // null = 1 (env steps between updates)
  "sac_sb3_gradient_steps": null,         // null = 1
  "sac_sb3_ent_coef": null,               // null = "auto" (autotuned, like our from-scratch SAC)
  "sac_sb3_target_update_interval": null, // null = 1

  // --- Reward shaping (ours; racetrack has no native speed term) -----------
  "high_speed_reward": null,          // null = train.py default (0.4)
  "collision_reward": null,           // null = train.py default (-5.0)
  "action_reward": null,              // null = train.py default (-0.1)
  "speed_reward_shape": null,         // null = "linear" (original, unchanged
                                       // behavior: coef*clip(speed/speed_limit,
                                       // 0,1.2), never negative). Set to
                                       // "tanh" for an S-curve: small bounded
                                       // NEGATIVE bonus standing still/reversing,
                                       // steep rise, diminishing returns (not
                                       // unbounded) at high speed -- see
                                       // HighSpeedRewardWrapper docstring.
  "speed_reward_v0_frac": null,       // null = 0.1 ("tanh" shape only)
  "speed_reward_steepness_frac": null, // null = 0.3 ("tanh" shape only)

  // --- 1) Delay / RDMDP-style augmented state (ours) -----------------------
  "enable_delay_wrapper": true,   // false = baseline, zero extra obs dims
  "action_delay_min_steps": 0,
  "action_delay_max_steps": 3,    // TRAIN with 0-3; see eval override note below
  "delay_known_to_agent": true,
  "observation_delay_steps": 0,   // simple FIFO delay, no reordering (pendencia)

  // --- Benchmark protocol (reference only -- scripts/train.py ignores any
  //      key starting with "_"; kept here so the answer to "how many
  //      seeds/episodes is standard" travels with the experiment grid) -----
  "_benchmark_protocol_reference": {
    "seeds_per_config": "5-10 independent seeds (Henderson et al. 2018; Colas et al. 2018, 'How Many Random Seeds?')",
    "periodic_eval_episodes_during_training": "5-10 (rl-baselines3-zoo default)",
    "final_eval_episodes": "~100 (rliable / Agarwal et al. 2021 convention)",
    "report_with": "IQM + bootstrap CI across seeds (rliable), not single-seed curves"
  }

  // --- Suggested evaluation override (apply on the CLI, not auto-applied --
  //      this config trains with a NARROWER delay range than it evaluates,
  //      per the project's generalization test):
  // python scripts/train.py --config configs/racetrack_experiment_config.jsonc \
  //     --action-delay-max-steps 6 --eval-episodes 100
}
